# Compact main view:
# - fixed-width commit IDs
# - compact dates/authors
# - tags/branches remain visible in the title
# - remote refs are hidden by reference-format below to avoid huge labels
set main-view = id:yes,color,width=9 date:relative-compact,width=7 author:abbreviated,width=4 commit-title:yes,graph=v2,refs,overflow=90
set refs-view = id:yes,color,width=9 date:relative-compact,width=7 author:abbreviated,width=4 ref:yes,maxwidth=44 commit-title:yes,refs=no,overflow=90
set reflog-view = id:yes,color,width=9 date:relative-compact,width=7 commit-title:yes,refs,overflow=90

# Keep important refs visible but hide noisy remote/prefetch refs in main view.
# Tags are shown before branches so release markers are easy to scan.
set reference-format = (head) <tag> [branch] hide:remote hide:tracked-remote ~replace~ hide:prefetch

# Keep the UI compact and readable in narrow terminals.
set line-graphics = utf-8
set truncation-delimiter = utf-8
set vertical-split = auto
set split-view-width = 55%
set horizontal-scroll = 25%

# Handy ref navigation.
bind generic r view-refs
bind generic m view-main
